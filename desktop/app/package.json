  "build": {
    "appId": "ai.hai.desktop",
    "productName": "HAI",
    "directories": {
      "output": "release"
    },
    "protocols": [
      {
        "name": "Agent Hub Deep Link",
        "schemes": ["hub"]
      }
    ],
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!node_modules"
    ],
    "asar": true,
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "dist/hai-bridge",
        "to": "hai-bridge"
      },
      {
        "from": "dist-mobile",
        "to": "mobile-web"
      },
      {
        "from": "../vendor/chrome-devtools-mcp",
        "to": "chrome-devtools-mcp"
      },
      {
        "from": "../computer-helper",
        "to": "computer-helper"
      },
      {
        "from": "../vendor/ego-browser-skill",
        "to": "ego-browser-skill"
      },
      {
        "from": "../vendor/office-skills",
        "to": "office-skills"
      },
      {
        "from": "../vendor/visual-skills",
        "to": "visual-skills"
      },
      {
        "from": "../vendor/create-mode-skills",
        "to": "create-mode-skills"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/HAI.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "background": "dmg-background.png",
      "iconSize": 128,
      "window": {
        "width": 700,
        "height": 460
      },
      "contents": [
        {
          "x": 200,
          "y": 236,
          "type": "file"
        },
        {
          "x": 500,
          "y": 236,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "katex": "^0.18.5",
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "rehype-katex": "^7.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "zustand": "^5.0.3"
  },
