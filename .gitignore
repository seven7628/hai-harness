# ══════════════════════════════════════════════════════════════════════════
# 本仓库只发布「内核 + bridge + 客户端」。
# 开发期资产（文档 / 设计稿 / 汇报材料 / 示例 / 测试与端到端 / 三方 vendored
# 资产 / 本机状态）一律不入版本库 —— 它们仍保留在本机工作目录里。
# ══════════════════════════════════════════════════════════════════════════

# —— 密钥 / 本地环境（绝不能提交）——
.env
.env.*
!.env.example

# —— 本机运行态数据（用户配置、会话、日志；含明文 provider key）——
.go-code/
.gocache/

# —— 开发期资产：不入版本库 ——
# 文档 / 设计稿 / 汇报材料 / 示例 / 构建与发布脚本 / 本机脚本
/docs/
/decks/
/examples/
/build_tools/
/internal/
/oss/
/scripts/
/promo-video/
/harness-audit/
/out/
/.design-research/
# 开发期的压缩评测脚本（体积与依赖都只对本机有意义）
/tools/eval_compress_v3.py
# 本机工具与编辑器状态
.agents/
.claude/
.idea/
.vscode/
.DS_Store
.playwright-cli/
.playwright-cli-config.json
